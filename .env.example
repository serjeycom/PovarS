TELEGRAM_BOT_TOKEN=replace_with_new_token
TELEGRAM_WEBHOOK_SECRET=replace_with_secret
# DATABASE_URL=postgres://user:password@localhost:5432/povar

# Токен доступа к админ-панели (/admin) — обязателен для её работы
ADMIN_TOKEN=replace_with_admin_token

# Публичный URL Mini App и ник бота (для кнопки «Открыть каталог» в боте)
MINI_APP_URL=https://your-domain.com/app/
BOT_USERNAME=your_bot_username
